<launch>
    <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
    <group>
        <push-ros-namespace namespace="yolo_autoware_tools"/>
        <node pkg="yolo_autoware_tools" exec="nearest_traffic_light" name="nearest_traffic_light" output="screen">
            <param name="map_path" value="$(var map_path)"/>
        </node>
    </group>
</launch>