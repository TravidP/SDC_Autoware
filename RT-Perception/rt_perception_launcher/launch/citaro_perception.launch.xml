<?xml version="1.0"?>
<launch>
    <arg name="object_detection_mode" default="radar" description="possible values: radar, yolo"/>
    <arg name="map_path"/>
    <arg name="use_sim_time" default="false"/>

    <group unless="$(var use_sim_time)">
        <!-- radar -->
        <group if="$(eval &quot;'$(var object_detection_mode)' == 'radar'&quot;)">
            <include file="$(find-pkg-share rt_radar_converter)/launch/rt_radar_converter.launch.xml"/>
        </group>

        <!-- yolo -->
        <group if="$(eval &quot;'$(var object_detection_mode)' == 'yolo'&quot;)">
            <include file="$(find-pkg-share bringup_launch)/launch/bringup.launch.py">
                <arg name="map_path" value="$(var map_path)"/>
            </include>

            <node pkg="object_detection_bridge" exec="object_detection_yolo_bridge" name="object_detection_yolo_bridge" output="screen"/>
        </group>
    </group>

    <!-- pointcloud preprocessing -->
    <include file="$(find-pkg-share gd_pointcloud_preprocessing)/launch/gd_pointcloud_preprocessing.launch.xml"/>

    <!-- occupancy grid map -->
    <arg name="occupancy_grid_map_method" default="pointcloud_based_occupancy_grid_map"/>
    <arg name="occupancy_grid_map_updater" default="binary_bayes_filter"/>

    <arg name="occupancy_grid_map_param_path" default="$(find-pkg-share rt_perception_launcher)/config/citaro/occupancy_grid_map/pointcloud_based_occupancy_grid_map.param.yaml"/>
    <arg name="occupancy_grid_map_updater_param_path" default="$(find-pkg-share rt_perception_launcher)/config/citaro/occupancy_grid_map/binary_bayes_filter_updater.param.yaml"/>
    <!-- container needed? -->
    <arg name="pointcloud_container_name" default=""/>
    <arg name="input/obstacle_pointcloud" default="/perception/obstacle_segmentation/pointcloud"/>
    <let name="input/raw_pointcloud" value="/sensing/camera/pointcloud_ex" if="$(var use_sim_time)"/>
    <let name="input/raw_pointcloud" value="/zed/zed_node/point_cloud/cloud_registered" unless="$(var use_sim_time)"/>
    <arg name="output" default="/perception/occupancy_grid_map/map"/>

    <group>
        <push-ros-namespace namespace="perception"/>
        <push-ros-namespace namespace="occupancy_grid_map"/>
        <include file="$(find-pkg-share autoware_probabilistic_occupancy_grid_map)/launch/pointcloud_based_occupancy_grid_map.launch.py">
            <arg name="input/obstacle_pointcloud" value="$(var input/obstacle_pointcloud)"/>
            <arg name="input/raw_pointcloud" value="$(var input/raw_pointcloud)"/>
            <arg name="output" value="$(var output)"/>
            <arg name="use_intra_process" value="false"/>
            <arg name="use_multithread" value="false"/>
            <arg name="use_pointcloud_container" value="false"/>
            <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
            <arg name="param_file" value="$(var occupancy_grid_map_param_path)"/>
            <arg name="updater_type" value="$(var occupancy_grid_map_updater)"/>
            <arg name="updater_param_file" value="$(var occupancy_grid_map_updater_param_path)"/>
        </include>
    </group>

</launch>
