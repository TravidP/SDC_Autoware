<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>svo_rosbag_sync</name>
  <version>0.1.0</version>
  <description>Synchronize ROS bag replay with SVO replay</description>
  <maintainer email="j.vanneerbos@greendino.nl">joel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_control_msgs</depend>
  <depend>fixposition_driver_ros2</depend>
  <depend>continental_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
