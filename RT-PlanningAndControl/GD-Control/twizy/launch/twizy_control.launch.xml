<?xml version="1.0"?>
<launch>
  <!-- Capture the environment variable from the system and set it as a launch variable -->
  <let name="VEHICLE" value="$(env VEHICLE)"/>

  <arg name="vehicle_model" default="$(var VEHICLE)_vehicle" description="vehicle model name"/>
  <arg name="vehicle_id" default="1" description="vehicle specific ID"/>
  <arg name="enable_autonomous_emergency_braking" default="true"/>
  <arg name="use_sim_time" default="false"/>

  <log message="use_sim_time: $(var use_sim_time)" />
  <!-- Control -->
  <include file="$(find-pkg-share gd_twizy_control)/launch/rt_tier4_control_component.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)" />
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="enable_autonomous_emergency_braking" value="$(var enable_autonomous_emergency_braking)"/>
  </include>
</launch>