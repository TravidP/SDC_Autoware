<launch>
    <arg name="launch_camera" default="true"/>
    <arg name="launch_gnss" default="true"/>
    <arg name="launch_radar" default="true"/>
    <arg name="launch_robot_state_publisher" default="true" description="Whether to launch robot_state_publisher"/>
    <arg name="vehicle_model" default="citaro_vehicle" description="vehicle model name"/>
    <arg name="sensor_model" default="gd_citaro_sensor" description="sensor model name"/>
    <arg name="config_dir" default="$(find-pkg-share $(var sensor_model)_description)/config" description="path to dir where sensors_calibration.yaml, etc. are located"/>
    <arg name="xsens_config_path" default="$(find-pkg-share $(var sensor_model)_launch)/config/xsens/xsens.yaml" description="path to dir where xsens.yaml, etc. are located"/>

    <!-- BaseLink and sensor TFs -->
    <group if="$(var launch_robot_state_publisher)">
        <arg name="model_file" default="$(find-pkg-share tier4_vehicle_launch)/urdf/vehicle.xacro" description="path to the file of model settings (*.xacro)"/>
        <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher">
            <param name="robot_description" value="$(command 'xacro $(var model_file) vehicle_model:=$(var vehicle_model) sensor_model:=$(var sensor_model) config_dir:=$(var config_dir)' 'warn')"/>
        </node>
    </group>

    <!-- Camera launch file  -->
    <group if="$(var launch_camera)">
        <include file="$(find-pkg-share gd_citaro_sensor_launch)/launch/zed_camera.launch.py">
            <arg name="camera_model" value="zed2i" />
        </include>
    </group>

    <!-- Gnss launch file -->
    <group if="$(var launch_gnss)">
        <include file="$(find-pkg-share gd_citaro_sensor_launch)/launch/xsens.launch.xml">
            <arg name="config_path" value="$(var xsens_config_path)" />
        </include>
    </group>

    <!-- Radar launch file -->
    <group if="$(var launch_radar)">
        <include file="$(find-pkg-share gd_citaro_sensor_launch)/launch/ars540.launch.xml"/>
    </group>

    <include file="$(find-pkg-share gd_citaro_sensor_launch)/launch/fppoi_baselink_tf.launch.py"/>
</launch>
